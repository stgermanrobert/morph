; Morph installer (Inno Setup 6). Build with:  ISCC /DMyVersion=1.0.0 morph.iss
; Generated by gen_packaging.py: edit the generator, not this file.
#ifndef MyVersion
  #define MyVersion "0.0.0"
#endif
#define MyAppName "Morph"
#define MyAppExe "Morph.exe"

[Setup]
AppId={{18CE169A-CDD1-5A11-A9AA-533571BE26E8}
AppName={#MyAppName}
AppVersion={#MyVersion}
AppVerName={#MyAppName} {#MyVersion}
AppPublisher=Germán Robert
AppPublisherURL=https://github.com/stgermanrobert/morph
AppSupportURL=https://github.com/stgermanrobert/morph/issues
AppUpdatesURL=https://github.com/stgermanrobert/morph/releases
VersionInfoVersion={#MyVersion}
VersionInfoDescription=Morph — Audio and video converter
DefaultDirName={autopf}\Morph
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
OutputDir=..\out
OutputBaseFilename=Morph-Setup-{#MyVersion}
SetupIconFile=morph.ico
UninstallDisplayIcon={app}\{#MyAppExe}
UninstallDisplayName={#MyAppName}
WizardStyle=modern
WizardImageFile=installer_side.bmp
WizardSmallImageFile=installer_small.bmp
LicenseFile=..\LICENSE
Compression=lzma2/max
SolidCompression=yes
LZMAUseSeparateProcess=yes
CloseApplications=yes
ShowLanguageDialog=auto

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "spanish"; MessagesFile: "compiler:Languages\Spanish.isl"
Name: "russian"; MessagesFile: "compiler:Languages\Russian.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"

[Files]
Source: "..\dist\Morph\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExe}"; AppUserModelID: "GermanRobert.Morph"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExe}"; AppUserModelID: "GermanRobert.Morph"; Tasks: desktopicon

[Registry]
Root: HKCU; Subkey: "Software\GermanRobert\Morph"; ValueType: string; ValueName: "InstallPath"; ValueData: "{app}"; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\GermanRobert\Morph"; ValueType: string; ValueName: "Version"; ValueData: "{#MyVersion}"
Root: HKCU; Subkey: "Software\GermanRobert\Morph"; ValueType: string; ValueName: "lang"; ValueData: "en"; Languages: english; Flags: createvalueifdoesntexist
Root: HKCU; Subkey: "Software\GermanRobert\Morph"; ValueType: string; ValueName: "lang"; ValueData: "es"; Languages: spanish; Flags: createvalueifdoesntexist
Root: HKCU; Subkey: "Software\GermanRobert\Morph"; ValueType: string; ValueName: "lang"; ValueData: "ru"; Languages: russian; Flags: createvalueifdoesntexist


[Run]
Filename: "{app}\{#MyAppExe}"; Description: "{cm:LaunchProgram,{#MyAppName}}"; Flags: nowait postinstall skipifsilent
